# ==============================================================================
# Kontext Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with real credentials into version control!
# ==============================================================================

# Optional Atlassian sync. Leave URLs and credentials blank to keep it disabled.
KONTEXT_ATLASSIAN_FLAVOR=cloud
KONTEXT_JIRA_URL=
KONTEXT_JIRA_PROJECTS=DEMO
KONTEXT_JIRA_JQL_EXTRA=
KONTEXT_CONFLUENCE_URL=
KONTEXT_CONFLUENCE_SPACES=DEMO
KONTEXT_ATLASSIAN_EMAIL=
KONTEXT_ATLASSIAN_TOKEN=
KONTEXT_ATLASSIAN_MAX_CONCURRENCY=4
KONTEXT_ATLASSIAN_SYNC_INTERVAL_SECONDS=86400

# Optional Notion integration; share the pages to index with this integration.
KONTEXT_NOTION_TOKEN=
KONTEXT_NOTION_API_VERSION=2026-03-11
KONTEXT_NOTION_SYNC_INTERVAL_SECONDS=86400

# Optional GitBook organization sync. Comma-separated space IDs; empty means all organization spaces.
KONTEXT_GITBOOK_TOKEN=
KONTEXT_GITBOOK_ORGANIZATION_ID=
KONTEXT_GITBOOK_SPACES=
KONTEXT_GITBOOK_SYNC_INTERVAL_SECONDS=86400

# Optional GitHub issue, pull request, and README sync. List repositories as owner/repo.
KONTEXT_GITHUB_TOKEN=
KONTEXT_GITHUB_REPOSITORIES=
KONTEXT_GITHUB_API_BASE_URL=https://api.github.com
KONTEXT_GITHUB_SYNC_INTERVAL_SECONDS=86400

# Optional GitLab issues, merge requests, and wiki sync. List projects as group/project.
KONTEXT_GITLAB_TOKEN=
KONTEXT_GITLAB_PROJECTS=
KONTEXT_GITLAB_API_BASE_URL=https://gitlab.com/api/v4
KONTEXT_GITLAB_SYNC_INTERVAL_SECONDS=86400

# Optional Linear issue, project, and document sync (personal API key).
KONTEXT_LINEAR_API_KEY=
KONTEXT_LINEAR_API_BASE_URL=https://api.linear.app/graphql
KONTEXT_LINEAR_SYNC_INTERVAL_SECONDS=86400

# Optional Zendesk Help Center public article sync; private and draft articles are excluded.
KONTEXT_ZENDESK_BASE_URL=
KONTEXT_ZENDESK_EMAIL=
KONTEXT_ZENDESK_API_TOKEN=
KONTEXT_ZENDESK_SYNC_INTERVAL_SECONDS=86400

# Optional Intercom Help Center article sync (token requires read_articles scope).
KONTEXT_INTERCOM_ACCESS_TOKEN=
KONTEXT_INTERCOM_API_BASE_URL=https://api.intercom.io
KONTEXT_INTERCOM_API_VERSION=2.17
KONTEXT_INTERCOM_SYNC_INTERVAL_SECONDS=86400

# Optional Freshdesk public Help Center article sync; private folders and drafts are excluded.
KONTEXT_FRESHDESK_BASE_URL=
KONTEXT_FRESHDESK_API_KEY=
KONTEXT_FRESHDESK_SYNC_INTERVAL_SECONDS=86400

# Optional Backstage Software Catalog entity sync; namespaces are comma-separated, empty means all accessible.
KONTEXT_BACKSTAGE_BASE_URL=
KONTEXT_BACKSTAGE_TOKEN=
KONTEXT_BACKSTAGE_NAMESPACES=
KONTEXT_BACKSTAGE_TECHDOCS_ENABLED=false
KONTEXT_BACKSTAGE_SYNC_INTERVAL_SECONDS=86400

# LLM (OpenAI-compatible server e.g. LM Studio, Ollama, vLLM)
KONTEXT_LLM_BASE_URL=http://host.docker.internal:1234/v1
KONTEXT_LLM_API_KEY=
KONTEXT_LLM_CHAT_MODEL=gemma-4
KONTEXT_LLM_EMBEDDING_MODEL=bge-m3
KONTEXT_LLM_EMBEDDING_DIMENSION=1024
KONTEXT_LLM_TEMPERATURE=0.2
KONTEXT_LLM_MAX_CONTEXT_CHUNKS=8

# Database configuration
KONTEXT_DB_URL=jdbc:postgresql://localhost:5432/kontext
KONTEXT_DB_USER=kontext
KONTEXT_DB_PASSWORD=

# Admin API (required to ingest manual documents)
# Generate a private value before exposing the admin API.
KONTEXT_ADMIN_TOKEN=
# Required to manage connector secrets from the UI. Generate with: openssl rand -base64 32
KONTEXT_SECRET_ENCRYPTION_KEY=

# Optional local Markdown/text/PDF/DOCX source; docker compose syncs files from ./knowledge every 5 minutes.
KONTEXT_FILES_DIRECTORY=/knowledge
KONTEXT_FILES_SYNC_INTERVAL_SECONDS=300

# Server
PORT=8080
